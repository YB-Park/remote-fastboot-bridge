{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "win-x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/win-x64",
      "cacheVariables": { "BUILD_TESTING": "ON", "FASTBOOT_PROXY_MOCK": "ON" }
    },
    {
      "name": "win-x64-package",
      "inherits": "win-x64",
      "binaryDir": "${sourceDir}/out/win-x64-package",
      "cacheVariables": { "BUILD_TESTING": "OFF", "FASTBOOT_PROXY_MOCK": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "win-x64-debug", "configurePreset": "win-x64", "configuration": "Debug" },
    { "name": "win-x64-release", "configurePreset": "win-x64", "configuration": "Release" },
    { "name": "win-x64-package", "configurePreset": "win-x64-package", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "win-x64-debug", "configurePreset": "win-x64", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "win-x64-release", "configurePreset": "win-x64", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
